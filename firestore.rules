rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRole() {
      // Get the role from the user's document
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // ---------------------------------------------------------
    // USERS COLLECTION
    // ---------------------------------------------------------
    match /users/{userId} {
      // Anyone logged in can read a user profile (needed for displayName, etc.)
      allow read: if isAuthenticated();
      
      // Users can only write their own document. Admins can write any document.
      allow write: if isAuthenticated() && (request.auth.uid == userId || getUserRole() == 'admin');
    }

    // ---------------------------------------------------------
    // MENU COLLECTION
    // ---------------------------------------------------------
    match /menu/{itemId} {
      // Anyone can read the menu (even unauthenticated, if you want public menus)
      allow read: if true; 
      
      // Only admins can modify the menu
      allow write: if isAuthenticated() && getUserRole() == 'admin';
    }

    // ---------------------------------------------------------
    // ORDERS COLLECTION
    // ---------------------------------------------------------
    match /orders/{orderId} {
      
      // READ Rules:
      // - Customers can read their own orders
      // - Delivery partners can read orders that are 'ready', 'claimed', or 'delivered'
      // - Admins can read all orders
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid || 
        getUserRole() == 'admin' || 
        (getUserRole() == 'delivery' && resource.data.status in ['ready', 'claimed', 'delivered'])
      );
      
      // CREATE Rules:
      // - Customers can create orders (must set customerId to their own uid)
      // - Admins can create orders on behalf of anyone
      allow create: if isAuthenticated() && (
        request.resource.data.customerId == request.auth.uid || 
        getUserRole() == 'admin'
      );
      
      // UPDATE Rules:
      // - Delivery partners can only update the status field to claim or deliver an order
      // - Admins can update anything
      allow update: if isAuthenticated() && (
        getUserRole() == 'admin' ||
        (
          getUserRole() == 'delivery' && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
          request.resource.data.status in ['claimed', 'delivered']
        )
      );
      
      // DELETE Rules:
      // - Only admins can delete orders
      allow delete: if isAuthenticated() && getUserRole() == 'admin';
    }
  }
}
